{
  "name": "@nero/tuyba",
  "private": true,
  "version": "0.1.0",
  "description": "TUYBA — first NERO CMS consumer application. Next.js App Router with Payload CMS mounted in the same deployment.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "seed:demo": "tsx scripts/seed-demo-content.ts",
    "seed:articles": "tsx scripts/seed-articles.ts",
    "scheduler:run": "tsx scripts/publish-scheduled.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@nero/cms-core": "workspace:*",
    "@nero/ui": "workspace:*",
    "@nero/web-core": "workspace:*",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.2",
    "graphql": "16.14.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@nero/tooling": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13"
  }
