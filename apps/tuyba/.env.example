# Copy this file to .env (in this directory) and fill in real values for
# local development. Never commit the resulting .env file.

# Postgres connection string used by the Payload Postgres adapter.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URI=postgresql://nero:nero@localhost:5432/nero_cms

# Secret used by Payload to sign tokens. Generate a long random value per environment.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Public base URL of the application, used for absolute links, admin config and metadata.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Shared secret authorizing draft/preview reads (see @nero/web-core's
# `previewToken` option). Generate a long random value per environment;
# preview requests must present this value to bypass the published-only
# content filter.
PREVIEW_SECRET=replace-with-a-long-random-secret
