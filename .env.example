# Copy this file to .env (in the repo root) for local Docker Compose overrides.
# These variables are read by docker-compose.yml, not by the apps.
# App-level env vars live in apps/*/.env (see apps/tuyba/.env.example).

# Host port to expose the local Postgres container on. Defaults to 5432.
# Set a different value if 5432 is already taken by another project.
# Keep it in sync with the port in apps/*/.env DATABASE_URI.
POSTGRES_PORT=5432
